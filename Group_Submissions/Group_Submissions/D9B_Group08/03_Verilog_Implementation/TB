`timescale 1ns / 1ps

module tb_forbidden_zone_rejector_h4;

    reg        clk;
    reg        reset;
    reg        start;
    reg        ack;
    reg  [3:0] x_in;

    wire [3:0] x_reg;
    wire [1:0] state;
    wire       y_out;
    wire       accept_led;
    wire       reject_led;
    wire [3:0] accept_count;
    wire [3:0] reject_count;

    forbidden_zone_rejector_h4 #(.COUNT_WIDTH(4)) dut (
        .clk          (clk),
        .reset        (reset),
        .start        (start),
        .ack          (ack),
        .x_in         (x_in),
        .x_reg        (x_reg),
        .state        (state),
        .y_out        (y_out),
        .accept_led   (accept_led),
        .reject_led   (reject_led),
        .accept_count (accept_count),
        .reject_count (reject_count)
    );

    // 100 MHz clock (10 ns period)
    initial clk = 1'b0;
    always #5 clk = ~clk;

    integer i;
    integer errors;
    reg [3:0] exp_accept;
    reg [3:0] exp_reject;
    reg       is_forbidden;

    initial begin
        errors     = 0;
        exp_accept = 4'd0;
        exp_reject = 4'd0;
        reset      = 1'b1;
        start      = 1'b0;
        ack        = 1'b0;
        x_in       = 4'd0;

        // 1. Verify Synchronous Active-High Reset
        repeat (2) @(posedge clk);
        @(negedge clk);
        if (state !== 2'b00 || y_out !== 1'b1 || accept_led !== 1'b1 || reject_led !== 1'b0 ||
            accept_count !== 4'd0 || reject_count !== 4'd0) begin
            $display("FAIL [RESET]: state=%b y=%b acc=%0d rej=%0d", state, y_out, accept_count, reject_count);
            errors = errors + 1;
        end else begin
            $display("PASS [RESET]: IDLE(00), Y=1, Accept_Count=0, Reject_Count=0");
        end
        reset = 1'b0;

        // 2. Exhaustive Verification of all 16 inputs (0 to 15)
        for (i = 0; i < 16; i = i + 1) begin
            is_forbidden = (i >= 6 && i <= 9);

            // Set X and assert START for 1 clock edge
            @(negedge clk);
            x_in  = i[3:0];
            start = 1'b1;
            ack   = 1'b0;

            @(posedge clk); // Cycle 1: FF1 captures START -> start_pulse = 1
            @(negedge clk);
            start = 1'b0;

            @(posedge clk); // Cycle 2: x_reg latches X, Q_d1 = 1
            @(posedge clk); // Cycle 3: FF_STATE updates, count_pulse = 1
            @(posedge clk); // Cycle 4: Selected 4-bit counter increments
            @(negedge clk);

            if (is_forbidden) begin
                exp_reject = exp_reject + 4'd1;
                if (x_reg !== i[3:0] || state !== 2'b01 || y_out !== 1'b0 ||
                    accept_led !== 1'b0 || reject_led !== 1'b1 ||
                    accept_count !== exp_accept || reject_count !== exp_reject) begin
                    $display("FAIL [X=%2d (%b)]: Exp REJECT(01) Y=0 Acc=%0d Rej=%0d | Got state=%b Y=%b Acc=%0d Rej=%0d",
                             i, i[3:0], exp_accept, exp_reject, state, y_out, accept_count, reject_count);
                    errors = errors + 1;
                end else begin
                    $display("PASS [X=%2d (%b)]: REJECT(01), Y=0, Reject_LED=1 | Acc=%0d Rej=%0d",
                             i, i[3:0], accept_count, reject_count);
                end

                // Verify ACK returns FSM to IDLE without incrementing counters
                ack = 1'b1;
                @(posedge clk);
                @(negedge clk);
                ack = 1'b0;

                if (state !== 2'b00 || y_out !== 1'b1 || accept_led !== 1'b1 || reject_led !== 1'b0 ||
                    accept_count !== exp_accept || reject_count !== exp_reject) begin
                    $display("FAIL [ACK after X=%2d]: state=%b Y=%b Acc=%0d Rej=%0d",
                             i, state, y_out, accept_count, reject_count);
                    errors = errors + 1;
                end else begin
                    $display("PASS [ACK after X=%2d]: Returned to IDLE(00), Y=1 (Counts unchanged)", i);
                end
            end else begin
                exp_accept = exp_accept + 4'd1;
                if (x_reg !== i[3:0] || state !== 2'b00 || y_out !== 1'b1 ||
                    accept_led !== 1'b1 || reject_led !== 1'b0 ||
                    accept_count !== exp_accept || reject_count !== exp_reject) begin
                    $display("FAIL [X=%2d (%b)]: Exp IDLE(00) Y=1 Acc=%0d Rej=%0d | Got state=%b Y=%b Acc=%0d Rej=%0d",
                             i, i[3:0], exp_accept, exp_reject, state, y_out, accept_count, reject_count);
                    errors = errors + 1;
                end else begin
                    $display("PASS [X=%2d (%b)]: ACCEPT/IDLE(00), Y=1, Accept_LED=1 | Acc=%0d Rej=%0d",
                             i, i[3:0], accept_count, reject_count);
                end
            end
        end

        // 3. Summary
        $display("------------------------------------------------------------");
        if (errors == 0 && accept_count == 4'd12 && reject_count == 4'd4)
            $display("ALL TESTS PASSED! Final Counts -> Accept=%0d (0x%h), Reject=%0d (0x%h)",
                     accept_count, accept_count, reject_count, reject_count);
        else
            $display("TEST FAILED with %0d error(s). Final Counts -> Accept=%0d, Reject=%0d",
                     errors, accept_count, reject_count);
        $display("------------------------------------------------------------");
        $finish;
    end

endmodule
