
`timescale 1ns / 1ps

module age_group_detector_tb;

    reg clk;
    reg reset;
    reg start;
    reg ack;
    reg [4:0] age_switches;

    wire child_led;
    wire teen_led;
    wire adult_led;
    wire senior_led;

    integer i;
    integer pass_count;
    integer fail_count;

    reg [3:0] expected;
    reg [3:0] actual;

    // =====================================
    // DUT INSTANTIATION
    // =====================================

    age_group_detector uut (
        .clk(clk),
        .reset(reset),
        .start(start),
        .ack(ack),
        .age_switches(age_switches),

        .child_led(child_led),
        .teen_led(teen_led),
        .adult_led(adult_led),
        .senior_led(senior_led)
    );

    // =====================================
    // CLOCK GENERATION
    // =====================================

    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    // =====================================
    // TEST TASK
    // =====================================

    task test_age;
        input [4:0] age;
        begin

            // Set expected output
            if (age < 13)
                expected = 4'b0001;
            else if (age < 20)
                expected = 4'b0010;
            else if (age < 26)
                expected = 4'b0100;
            else
                expected = 4'b1000;

            // Apply age and START
            @(negedge clk);
            age_switches = age;
            start = 1;

            @(negedge clk);
            start = 0;

            // Wait for CHECK and classification
            @(posedge clk);
            #1;

            actual = {
                senior_led,
                adult_led,
                teen_led,
                child_led
            };

            // Compare expected and actual outputs
            if (actual === expected) begin

                $display(
                    "PASS: Age=%0d, Expected=%b, Actual=%b",
                    age, expected, actual
                );

                pass_count = pass_count + 1;

            end
            else begin

                $display(
                    "FAIL: Age=%0d, Expected=%b, Actual=%b",
                    age, expected, actual
                );

                fail_count = fail_count + 1;

            end

            // ACK to return to IDLE
            @(negedge clk);
            ack = 1;

            @(negedge clk);
            ack = 0;

        end
    endtask

    // =====================================
    // MAIN TEST SEQUENCE
    // =====================================

    initial begin

        reset = 1;
        start = 0;
        ack = 0;
        age_switches = 0;

        pass_count = 0;
        fail_count = 0;

        // Apply reset
        repeat(2) @(posedge clk);
        @(negedge clk);
        reset = 0;

        // Test all 32 age values
        for (i = 0; i < 32; i = i + 1) begin
            test_age(i);
        end

        // Final verification summary
        $display("--------------------------------");
        $display("TOTAL TESTS : 32");
        $display("PASSED      : %0d", pass_count);
        $display("FAILED      : %0d", fail_count);
        $display("--------------------------------");

        if (fail_count == 0)
            $display("ALL TESTS PASSED!");
        else
            $display("SOME TESTS FAILED!");

        $finish;

    end

endmodule
