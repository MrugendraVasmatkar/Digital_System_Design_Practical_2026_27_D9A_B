## =====================================================================
## Boolean Board constraints for top module: age_group_mealy
## Part: xc7s50csga324-1
## Pin locations from Real Digital's official Boolean constraints file
##
##   SW4..SW0 = age_sw[4:0]   SW15 = start   SW14 = ack   BTN0 = reset
##   LD0 = child_led          LD1 = teen_led LD2 = adult_led
## =====================================================================

## 100 MHz clock
set_property -dict {PACKAGE_PIN F14 IOSTANDARD LVCMOS33} [get_ports {clk}]
create_clock -name sys_clk -period 10.000 -waveform {0 5} [get_ports {clk}]

## Age switches  A0..A4 = SW0..SW4
set_property -dict {PACKAGE_PIN V2 IOSTANDARD LVCMOS33} [get_ports {age_sw[0]}]
set_property -dict {PACKAGE_PIN U2 IOSTANDARD LVCMOS33} [get_ports {age_sw[1]}]
set_property -dict {PACKAGE_PIN U1 IOSTANDARD LVCMOS33} [get_ports {age_sw[2]}]
set_property -dict {PACKAGE_PIN T2 IOSTANDARD LVCMOS33} [get_ports {age_sw[3]}]
set_property -dict {PACKAGE_PIN T1 IOSTANDARD LVCMOS33} [get_ports {age_sw[4]}]

## Control inputs
set_property -dict {PACKAGE_PIN K1 IOSTANDARD LVCMOS33} [get_ports {start}]
set_property -dict {PACKAGE_PIN K2 IOSTANDARD LVCMOS33} [get_ports {ack}]
set_property -dict {PACKAGE_PIN J2 IOSTANDARD LVCMOS33} [get_ports {reset}]

## Output LEDs
set_property -dict {PACKAGE_PIN G1 IOSTANDARD LVCMOS33} [get_ports {child_led}]
set_property -dict {PACKAGE_PIN G2 IOSTANDARD LVCMOS33} [get_ports {teen_led}]
set_property -dict {PACKAGE_PIN F1 IOSTANDARD LVCMOS33} [get_ports {adult_led}]

## Configuration
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]

## Clock routing override (keeps the earlier Place 30-574 error away)
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets clk_IBUF]
