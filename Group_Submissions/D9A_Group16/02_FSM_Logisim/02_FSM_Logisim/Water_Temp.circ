<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  This file is intended to be loaded by Logisim (http://www.cburch.com/logisim/).
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="6" map="Button2" name="Menu Tool"/>
    <tool lib="6" map="Button3" name="Menu Tool"/>
    <tool lib="6" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
    <tool lib="6" name="Text Tool">
      <a name="text" val=""/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="center"/>
      <a name="valign" val="base"/>
    </tool>
    <sep/>
    <tool lib="0" name="Pin">
      <a name="tristate" val="false"/>
    </tool>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="labelloc" val="east"/>
    </tool>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
  </toolbar>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Input: Temp[2:0] -->
    <comp lib="0" loc="(100,220)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="width" val="3"/>
      <a name="label" val="Temp"/>
    </comp>

    <!-- Stage 1: Comparators -->
    <comp lib="0" loc="(200,120)" name="Constant">
      <a name="width" val="3"/>
      <a name="value" val="0x4"/>
    </comp>
    <comp lib="3" loc="(260,110)" name="Comparator">
      <a name="width" val="3"/>
      <a name="mode" val="unsigned"/>
    </comp>

    <comp lib="0" loc="(200,240)" name="Constant">
      <a name="width" val="3"/>
      <a name="value" val="0x5"/>
    </comp>
    <comp lib="3" loc="(260,230)" name="Comparator">
      <a name="width" val="3"/>
      <a name="mode" val="unsigned"/>
    </comp>

    <!-- Stage 2: Comparator 3 (Temp < 2) -->
    <comp lib="0" loc="(200,350)" name="Constant">
      <a name="width" val="3"/>
      <a name="value" val="0x2"/>
    </comp>
    <comp lib="3" loc="(260,340)" name="Comparator">
      <a name="width" val="3"/>
      <a name="mode" val="unsigned"/>
    </comp>

    <!-- NOR gate (neutral) -->
    <comp lib="1" loc="(400,170)" name="NOR Gate">
      <a name="size" val="30"/>
      <a name="inputs" val="2"/>
    </comp>

    <!-- AND gate -> VC (C1 AND C3) -->
    <comp lib="1" loc="(400,400)" name="AND Gate">
      <a name="size" val="30"/>
      <a name="inputs" val="2"/>
    </comp>

    <!-- NOT gate on C3 -->
    <comp lib="1" loc="(350,490)" name="NOT Gate">
      <a name="size" val="30"/>
    </comp>

    <!-- AND gate -> COLD (C1 AND NOT C3) -->
    <comp lib="1" loc="(400,480)" name="AND Gate">
      <a name="size" val="30"/>
      <a name="inputs" val="2"/>
    </comp>

    <!-- Outputs -->
    <comp lib="0" loc="(480,220)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="HOT"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(480,170)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="NEUTRAL"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(480,400)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="VC"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(480,480)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="COLD"/>
      <a name="labelloc" val="east"/>
    </comp>

    <!-- Labels -->
    <comp lib="6" loc="(260,80)" name="Text">
      <a name="text" val="Comparator 1: Temp &lt; 4 (0-3)"/>
    </comp>
    <comp lib="6" loc="(260,200)" name="Text">
      <a name="text" val="Comparator 2: Temp &gt; 5 (6-7)"/>
    </comp>
    <comp lib="6" loc="(260,310)" name="Text">
      <a name="text" val="Comparator 3: Temp &lt; 2"/>
    </comp>
    <comp lib="6" loc="(400,140)" name="Text">
      <a name="text" val="NOR: neutral (4-5)"/>
    </comp>
    <comp lib="6" loc="(420,375)" name="Text">
      <a name="text" val="VC = C1 AND C3 (0-1)"/>
    </comp>
    <comp lib="6" loc="(420,520)" name="Text">
      <a name="text" val="COLD = C1 AND NOT C3 (2-3)"/>
    </comp>

    <!-- Temp bus -->
    <wire from="(100,220)" to="(140,220)"/>
    <wire from="(140,100)" to="(140,220)"/>
    <wire from="(140,220)" to="(140,330)"/>
    <wire from="(140,220)" to="(220,220)"/>
    <wire from="(140,100)" to="(220,100)"/>
    <wire from="(140,330)" to="(220,330)"/>

    <!-- Constants to comparator B inputs -->
    <wire from="(200,120)" to="(220,120)"/>
    <wire from="(200,240)" to="(220,240)"/>
    <wire from="(200,350)" to="(220,350)"/>

    <!-- Comparator 1 output (Temp &lt; 4) -->
    <wire from="(260,120)" to="(300,120)"/>
    <wire from="(300,120)" to="(300,160)"/>
    <wire from="(300,160)" to="(370,160)"/>
    <wire from="(300,160)" to="(300,390)"/>
    <wire from="(300,390)" to="(370,390)"/>
    <wire from="(300,390)" to="(300,470)"/>
    <wire from="(300,470)" to="(370,470)"/>

    <!-- Comparator 2 output (Temp &gt; 5) -> NOR and HOT -->
    <wire from="(260,220)" to="(330,220)"/>
    <wire from="(330,220)" to="(330,180)"/>
    <wire from="(330,180)" to="(370,180)"/>
    <wire from="(330,220)" to="(480,220)"/>

    <!-- NOR output -> NEUTRAL -->
    <wire from="(400,170)" to="(480,170)"/>

    <!-- Comparator 3 output (Temp &lt; 2) -->
    <wire from="(260,350)" to="(320,350)"/>
    <wire from="(320,350)" to="(320,410)"/>
    <wire from="(320,410)" to="(370,410)"/>
    <wire from="(320,410)" to="(320,490)"/>

    <!-- NOT output -> lower AND -->
    <wire from="(350,490)" to="(370,490)"/>

    <!-- AND outputs -->
    <wire from="(400,400)" to="(480,400)"/>
    <wire from="(400,480)" to="(480,480)"/>

    <!-- ===== H1 additions: classifier outputs -> tunnels (original classifier above is unchanged) ===== -->
    <comp lib="6" loc="(250,40)" name="Text">
      <a name="text" val="1) TEMPERATURE CLASSIFIER (original two-stage comparator logic)"/>
    </comp>
    <wire from="(450,170)" to="(450,180)"/>
    <comp lib="0" loc="(450,180)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="CLS_NEUTRAL"/>
    </comp>
    <wire from="(450,220)" to="(450,230)"/>
    <comp lib="0" loc="(450,230)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="CLS_HOT"/>
    </comp>
    <wire from="(450,400)" to="(450,410)"/>
    <comp lib="0" loc="(450,410)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="CLS_VC"/>
    </comp>
    <wire from="(450,480)" to="(450,470)"/>
    <comp lib="0" loc="(450,470)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="CLS_COLD"/>
    </comp>

    <!-- ===== 2) Control inputs ===== -->
    <comp lib="6" loc="(200,590)" name="Text">
      <a name="text" val="2) CONTROL INPUTS (active-high)"/>
    </comp>
    <comp lib="0" loc="(100,620)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="START"/>
    </comp>
    <wire from="(100,620)" to="(140,620)"/>
    <comp lib="0" loc="(140,620)" name="Tunnel">
      <a name="label" val="START"/>
    </comp>
    <comp lib="0" loc="(100,680)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="ACK"/>
    </comp>
    <wire from="(100,680)" to="(140,680)"/>
    <comp lib="0" loc="(140,680)" name="Tunnel">
      <a name="label" val="ACK"/>
    </comp>
    <comp lib="0" loc="(100,740)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="RESET"/>
    </comp>
    <wire from="(100,740)" to="(140,740)"/>
    <comp lib="0" loc="(140,740)" name="Tunnel">
      <a name="label" val="RESET"/>
    </comp>
    <comp lib="0" loc="(100,800)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="CLK"/>
    </comp>
    <wire from="(100,800)" to="(140,800)"/>
    <comp lib="0" loc="(140,800)" name="Tunnel">
      <a name="label" val="CLK"/>
    </comp>
    <comp lib="1" loc="(400,680)" name="NOT Gate">
      <a name="size" val="30"/>
    </comp>
    <wire from="(350,680)" to="(370,680)"/>
    <comp lib="0" loc="(350,680)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="ACK"/>
    </comp>
    <wire from="(400,680)" to="(420,680)"/>
    <comp lib="0" loc="(420,680)" name="Tunnel">
      <a name="label" val="NACK"/>
    </comp>
    <comp lib="1" loc="(400,740)" name="NOT Gate">
      <a name="size" val="30"/>
    </comp>
    <wire from="(350,740)" to="(370,740)"/>
    <comp lib="0" loc="(350,740)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="RESET"/>
    </comp>
    <wire from="(400,740)" to="(420,740)"/>
    <comp lib="0" loc="(420,740)" name="Tunnel">
      <a name="label" val="NRESET"/>
    </comp>
    <comp lib="6" loc="(260,840)" name="Text">
      <a name="text" val="RESET is synchronous: it acts on the next rising CLK edge"/>
    </comp>

    <!-- ===== 3) State decoder ===== -->
    <comp lib="6" loc="(870,40)" name="Text">
      <a name="text" val="3) STATE DECODER"/>
    </comp>
    <comp lib="1" loc="(900,100)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(830,80)" to="(850,80)"/>
    <comp lib="0" loc="(830,80)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ2"/>
    </comp>
    <wire from="(830,100)" to="(850,100)"/>
    <comp lib="0" loc="(830,100)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ1"/>
    </comp>
    <wire from="(830,120)" to="(850,120)"/>
    <comp lib="0" loc="(830,120)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ0"/>
    </comp>
    <wire from="(900,100)" to="(920,100)"/>
    <comp lib="0" loc="(920,100)" name="Tunnel">
      <a name="label" val="IDLE"/>
    </comp>
    <comp lib="1" loc="(900,180)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(830,160)" to="(850,160)"/>
    <comp lib="0" loc="(830,160)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ2"/>
    </comp>
    <wire from="(830,180)" to="(850,180)"/>
    <comp lib="0" loc="(830,180)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ1"/>
    </comp>
    <wire from="(830,200)" to="(850,200)"/>
    <comp lib="0" loc="(830,200)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="Q0"/>
    </comp>
    <wire from="(900,180)" to="(920,180)"/>
    <comp lib="0" loc="(920,180)" name="Tunnel">
      <a name="label" val="VC_STATE"/>
    </comp>
    <comp lib="1" loc="(900,260)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(830,240)" to="(850,240)"/>
    <comp lib="0" loc="(830,240)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ2"/>
    </comp>
    <wire from="(830,260)" to="(850,260)"/>
    <comp lib="0" loc="(830,260)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="Q1"/>
    </comp>
    <wire from="(830,280)" to="(850,280)"/>
    <comp lib="0" loc="(830,280)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ0"/>
    </comp>
    <wire from="(900,260)" to="(920,260)"/>
    <comp lib="0" loc="(920,260)" name="Tunnel">
      <a name="label" val="COLD_STATE"/>
    </comp>
    <comp lib="1" loc="(900,340)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(830,320)" to="(850,320)"/>
    <comp lib="0" loc="(830,320)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ2"/>
    </comp>
    <wire from="(830,340)" to="(850,340)"/>
    <comp lib="0" loc="(830,340)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="Q1"/>
    </comp>
    <wire from="(830,360)" to="(850,360)"/>
    <comp lib="0" loc="(830,360)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="Q0"/>
    </comp>
    <wire from="(900,340)" to="(920,340)"/>
    <comp lib="0" loc="(920,340)" name="Tunnel">
      <a name="label" val="NEUTRAL_STATE"/>
    </comp>
    <comp lib="1" loc="(900,420)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(830,400)" to="(850,400)"/>
    <comp lib="0" loc="(830,400)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="Q2"/>
    </comp>
    <wire from="(830,420)" to="(850,420)"/>
    <comp lib="0" loc="(830,420)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ1"/>
    </comp>
    <wire from="(830,440)" to="(850,440)"/>
    <comp lib="0" loc="(830,440)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NQ0"/>
    </comp>
    <wire from="(900,420)" to="(920,420)"/>
    <comp lib="0" loc="(920,420)" name="Tunnel">
      <a name="label" val="HOT_STATE"/>
    </comp>
    <comp lib="6" loc="(870,480)" name="Text">
      <a name="text" val="IDLE=000  VC=001  COLD=010  NEUTRAL=011  HOT=100"/>
    </comp>

    <!-- ===== 4) Next-state logic ===== -->
    <comp lib="6" loc="(1500,40)" name="Text">
      <a name="text" val="4) NEXT-STATE LOGIC"/>
    </comp>
    <comp lib="6" loc="(1500,790)" name="Text">
      <a name="text" val="D2 = ~R.[(I.S.H) + (H_s.~A)]"/>
    </comp>
    <comp lib="6" loc="(1500,810)" name="Text">
      <a name="text" val="D1 = ~R.[(I.S.C) + (I.S.N) + (C_s.~A) + (N_s.~A)]"/>
    </comp>
    <comp lib="6" loc="(1500,830)" name="Text">
      <a name="text" val="D0 = ~R.[(I.S.VC) + (I.S.N) + (V.~A) + (N_s.~A)]"/>
    </comp>
    <comp lib="1" loc="(1250,100)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(1180,80)" to="(1200,80)"/>
    <comp lib="0" loc="(1180,80)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="IDLE"/>
    </comp>
    <wire from="(1180,100)" to="(1200,100)"/>
    <comp lib="0" loc="(1180,100)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="START"/>
    </comp>
    <wire from="(1180,120)" to="(1200,120)"/>
    <comp lib="0" loc="(1180,120)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="CLS_HOT"/>
    </comp>
    <wire from="(1250,100)" to="(1270,100)"/>
    <comp lib="0" loc="(1270,100)" name="Tunnel">
      <a name="label" val="IS_H"/>
    </comp>
    <comp lib="1" loc="(1250,180)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <wire from="(1180,160)" to="(1200,160)"/>
    <comp lib="0" loc="(1180,160)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="HOT_STATE"/>
    </comp>
    <wire from="(1180,200)" to="(1200,200)"/>
    <comp lib="0" loc="(1180,200)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NACK"/>
    </comp>
    <wire from="(1250,180)" to="(1270,180)"/>
    <comp lib="0" loc="(1270,180)" name="Tunnel">
      <a name="label" val="HOLD_H"/>
    </comp>
    <comp lib="1" loc="(1250,280)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(1180,260)" to="(1200,260)"/>
    <comp lib="0" loc="(1180,260)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="IDLE"/>
    </comp>
    <wire from="(1180,280)" to="(1200,280)"/>
    <comp lib="0" loc="(1180,280)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="START"/>
    </comp>
    <wire from="(1180,300)" to="(1200,300)"/>
    <comp lib="0" loc="(1180,300)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="CLS_COLD"/>
    </comp>
    <wire from="(1250,280)" to="(1270,280)"/>
    <comp lib="0" loc="(1270,280)" name="Tunnel">
      <a name="label" val="IS_C"/>
    </comp>
    <comp lib="1" loc="(1250,360)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(1180,340)" to="(1200,340)"/>
    <comp lib="0" loc="(1180,340)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="IDLE"/>
    </comp>
    <wire from="(1180,360)" to="(1200,360)"/>
    <comp lib="0" loc="(1180,360)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="START"/>
    </comp>
    <wire from="(1180,380)" to="(1200,380)"/>
    <comp lib="0" loc="(1180,380)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="CLS_NEUTRAL"/>
    </comp>
    <wire from="(1250,360)" to="(1270,360)"/>
    <comp lib="0" loc="(1270,360)" name="Tunnel">
      <a name="label" val="IS_N"/>
    </comp>
    <comp lib="1" loc="(1250,440)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <wire from="(1180,420)" to="(1200,420)"/>
    <comp lib="0" loc="(1180,420)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="COLD_STATE"/>
    </comp>
    <wire from="(1180,460)" to="(1200,460)"/>
    <comp lib="0" loc="(1180,460)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NACK"/>
    </comp>
    <wire from="(1250,440)" to="(1270,440)"/>
    <comp lib="0" loc="(1270,440)" name="Tunnel">
      <a name="label" val="HOLD_C"/>
    </comp>
    <comp lib="1" loc="(1250,520)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <wire from="(1180,500)" to="(1200,500)"/>
    <comp lib="0" loc="(1180,500)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NEUTRAL_STATE"/>
    </comp>
    <wire from="(1180,540)" to="(1200,540)"/>
    <comp lib="0" loc="(1180,540)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="NACK"/>
    </comp>
    <wire from="(1250,520)" to="(1270,520)"/>
    <comp lib="0" loc="(1270,520)" name="Tunnel">
      <a name="label" val="HOLD_N"/>
    </comp>
    <comp lib="1" loc="(1250,620)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="3"/>
    </comp>
    <wire from="(1180,600)" to="(1200,600)"/>
    <comp lib="0" loc="(1180,600)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="IDLE"/>
    </comp>
    <wire from="(1180,620)" to="(1200,620)"/>
    <comp lib="0" loc="(1180,620)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="START"/>
    </comp>
    <wire from="(1180,640)" to="(1200,640)"/>
    <comp lib="0" loc="(1180,640)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="CLS_VC"/>
