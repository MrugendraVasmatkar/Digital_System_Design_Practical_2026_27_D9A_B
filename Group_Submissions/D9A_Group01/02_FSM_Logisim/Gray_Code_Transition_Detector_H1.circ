    <comp lib="0" loc="(820,290)" name="Constant"><a name="width" val="4"/><a name="value" val="0x0"/></comp>
    <comp lib="3" loc="(900,150)" name="Comparator"><a name="width" val="4"/><a name="mode" val="unsigned"/><a name="label" val="D_NONZERO"/></comp>
