    <comp lib="4" loc="(1400,310)" name="Register"><a name="appearance" val="classic"/><a name="width" val="1"/><a name="trigger" val="falling"/><a name="label" val="S0_VALID"/></comp>
    <comp lib="4" loc="(1700,310)" name="Register"><a name="appearance" val="classic"/><a name="width" val="1"/><a name="trigger" val="falling"/><a name="label" val="S1_INVALID"/></comp>
    <comp lib="5" loc="(1500,310)" name="LED"><a name="color" val="#00c000"/><a name="label" val="VALID"/></comp>
    <comp lib="5" loc="(1800,310)" name="LED"><a name="color" val="#f00000"/><a name="label" val="INVALID"/></comp>
    <comp lib="6" loc="(520,40)" name="Text"><a name="text" val="GRAY CODE TRANSITION DETECTOR - Moore FSM + H1 (N-bit one-bit-change detector)"/></comp>
    <comp lib="6" loc="(400,135)" name="Text"><a name="text" val="X REG -> P REG (load on START, rising edge)"/></comp>
    <comp lib="6" loc="(840,350)" name="Text"><a name="text" val="H1 DETECTOR: D = X xor P ;  V = (D > 0) AND ((D AND (D-1)) = 0)"/></comp>
    <comp lib="6" loc="(1410,140)" name="Text"><a name="text" val="MOORE FSM  (state regs on falling edge)"/></comp>
    <comp lib="6" loc="(1560,450)" name="Text"><a name="text" val="State: 00=IDLE (both LEDs off), 01=VALID (V=1), 10=INVALID (V=0)"/></comp>
    <comp lib="6" loc="(1560,470)" name="Text"><a name="text" val="VALID LED = S0, INVALID LED = S1 (state 11 never occurs)"/></comp>
    <comp lib="6" loc="(560,440)" name="Text"><a name="text" val="HOW TO RUN: set X, set START=1, tick the clock twice (rise + fall), set START=0.  ACK or RESET -> IDLE."/></comp>
    <comp lib="6" loc="(560,460)" name="Text"><a name="text" val="N-BIT (H1): select X pin, X/P regs, XOR, subtractor, AND, 2 comparators, 3 constants -> set Data Bits = N."/></comp>
  </circuit>
