module tb_fz_rejector;
    parameter N = 7;
    parameter L = 62;
    parameter H = 89;

    reg          clk, reset, start, ack;
    reg  [N-1:0] x;
    wire [N-1:0] x_reg;
    wire         accept_led, reject_led;

    integer i;

    fz_rejector #(
        .N(N),
        .L(L),
        .H(H)
    ) uut (
        .clk        (clk),
        .reset      (reset),
        .start      (start),
        .ack        (ack),
        .x          (x),
        .x_reg      (x_reg),
        .accept_led (accept_led),
        .reject_led (reject_led)
    );

    always #5 clk = ~clk;

    initial begin
        clk = 0; reset = 1; start = 0; ack = 0; x = 0;
        #10 reset = 0;

        for (i = 0; i < (1 << N); i = i + 1) begin
            x = i[N-1:0];
            start = 1; #10;
            start = 0;

            $display("X = %2d (%b) | ACCEPT = %b | REJECT = %b | %s",
                     x, x, accept_led, reject_led,
                     (reject_led == ((i >= L) && (i <= H))) ? "PASS" : "FAIL");

            if (reject_led) begin
                ack = 1; #10;
                ack = 0;
            end
        end

        #10 $finish;
    end
endmodule
