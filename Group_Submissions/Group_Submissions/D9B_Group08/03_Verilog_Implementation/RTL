`timescale 1ns / 1ps

// -----------------------------------------------------------------------------
// Module 1: 2-FF Registered Rising-Edge Pulse Generator (Q1 & ~Q2)
// -----------------------------------------------------------------------------
module start_pulse_gen (
    input  wire clk,
    input  wire reset,       // Synchronous, active-high
    input  wire start_in,
    output wire start_pulse
);
    reg q1, q2;

    always @(posedge clk) begin
        if (reset) begin
            q1 <= 1'b0;
            q2 <= 1'b0;
        end else begin
            q1 <= start_in;
            q2 <= q1;
        end
    end

    assign start_pulse = q1 & ~q2;
endmodule

// -----------------------------------------------------------------------------
// Module 2: Combinational Forbidden Zone Detector (Your Exact Equation)
// Y = X3'X2' + X2X1' + X3X1  (1 = Allowed, 0 = Forbidden 6..9)
// -----------------------------------------------------------------------------
module fz_detector_y (
    input  wire [3:0] x,
    output wire       y,
    output wire       fz
);
    assign y  = (~x[3] & ~x[2]) | (x[2] & ~x[1]) | (x[3] & x[1]);
    assign fz = ~y;
endmodule

// -----------------------------------------------------------------------------
// Module 3: H4 Synchronous 4-Bit Accept & Reject Counters (Using Enable)
// -----------------------------------------------------------------------------
module h4_counters #(
    parameter WIDTH = 4
) (
    input  wire             clk,
    input  wire             reset,       // Synchronous, active-high
    input  wire             en_accept,
    input  wire             en_reject,
    output reg  [WIDTH-1:0] accept_count,
    output reg  [WIDTH-1:0] reject_count
);
    always @(posedge clk) begin
        if (reset) begin
            accept_count <= {WIDTH{1'b0}};
            reject_count <= {WIDTH{1'b0}};
        end else begin
            if (en_accept)
                accept_count <= accept_count + 1'b1;
            if (en_reject)
                reject_count <= reject_count + 1'b1;
        end
    end
endmodule

// -----------------------------------------------------------------------------
// Module 4: Core Forbidden Zone Rejector (1-to-1 Match to Logisim Circuit)
// 4-cycle pipeline: FF1 -> Input Reg & D1 -> FF_STATE & D2 -> H4 Counters
// -----------------------------------------------------------------------------
module forbidden_zone_rejector_h4 #(
    parameter COUNT_WIDTH = 4
) (
    input  wire                   clk,
    input  wire                   reset,        // Synchronous, active-high
    input  wire                   start,        // Load/sample X[3:0]
    input  wire                   ack,          // Return REJECT to IDLE
    input  wire [3:0]             x_in,         // 4-bit switch input
    output reg  [3:0]             x_reg,        // 4-bit latched input register
    output wire [1:0]             state,        // 00 = IDLE, 01 = REJECT
    output wire                   y_out,        // Moore output (1=Accept, 0=Reject)
    output wire                   accept_led,   // Green LED
    output wire                   reject_led,   // Red LED
    output wire [COUNT_WIDTH-1:0] accept_count, // H4: Accepted count
    output wire [COUNT_WIDTH-1:0] reject_count  // H4: Rejected count
);
    // 1. Rising-edge pulse generator on START
    wire start_pulse;
    start_pulse_gen u_pulse (
        .clk         (clk),
        .reset       (reset),
        .start_in    (start),
        .start_pulse (start_pulse)
    );

    // 2. 4-Bit Input Register (WE = start_pulse)
    always @(posedge clk) begin
        if (reset)
            x_reg <= 4'b0000;
        else if (start_pulse)
            x_reg <= x_in;
    end

    // 3. Combinational Forbidden Zone Detector on registered x_reg
    wire y_det, fz_det;
    fz_detector_y u_det (
        .x  (x_reg),
        .y  (y_det),
        .fz (fz_det)
    );

    // 4. 2-Stage Pipeline Alignment Flip-Flops (D1 -> Q_d1, D2 -> count_pulse)
    reg q_d1;
    reg count_pulse;

    always @(posedge clk) begin
        if (reset) begin
            q_d1        <= 1'b0;
            count_pulse <= 1'b0;
        end else begin
            q_d1        <= start_pulse;
            count_pulse <= q_d1;
        end
    end

    // 5. 2-State Moore FSM Controller (FF_STATE: 0 = IDLE, 1 = REJECT)
    // Q+ = (Q_d1 & ~Y) | (Q & ~Q_d1 & ~ACK)
    reg  q_state;
    wire d_state = (q_d1 & fz_det) | (q_state & ~q_d1 & ~ack);

    always @(posedge clk) begin
        if (reset)
            q_state <= 1'b0;
        else
            q_state <= d_state;
    end

    // Moore Outputs (depend strictly on q_state)
    assign state      = {1'b0, q_state};
    assign reject_led = q_state;
    assign accept_led = ~q_state;
    assign y_out      = ~q_state;

    // 6. H4 Counter Enable Logic & 4-Bit Counters
    wire en_accept = count_pulse & accept_led;
    wire en_reject = count_pulse & reject_led;

    h4_counters #(.WIDTH(COUNT_WIDTH)) u_counters (
        .clk          (clk),
        .reset        (reset),
        .en_accept    (en_accept),
        .en_reject    (en_reject),
        .accept_count (accept_count),
        .reject_count (reject_count)
    );

endmodule
